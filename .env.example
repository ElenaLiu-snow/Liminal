# Never put a real API key in this committed example file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Structured JSON stages default to non-thinking mode for speed and reliability.
DEEPSEEK_THINKING=disabled
# Used only when DEEPSEEK_THINKING=enabled.
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_ATTEMPTS=3

# Optional comma-separated browser origins when serving the local display demo.
LIMINAL_DEMO_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3002,http://localhost:3002
