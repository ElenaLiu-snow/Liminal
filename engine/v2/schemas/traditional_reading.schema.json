{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liminal.local/schemas/v2/traditional_reading.schema.json",
  "title": "Liminal v2 traditional tarot layer contracts",
  "$defs": {
    "canonicalReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "orientation",
        "stable_meaning",
        "visual_symbols",
        "core_themes",
        "source_refs",
        "source_status"
      ],
      "properties": {
        "card_id": {"type": "string", "minLength": 1},
        "orientation": {"enum": ["upright", "reversed"]},
        "stable_meaning": {"type": "string", "minLength": 1},
        "visual_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "core_themes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_status": {
          "enum": ["provisional_v1_dataset", "waite_verified", "human_reviewed"]
        }
      }
    },
    "situatedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "orientation",
        "card_role_in_question",
        "practical_tension",
        "bounded_direction",
        "reflection_point",
        "source_refs"
      ],
      "properties": {
        "card_id": {"type": "string", "minLength": 1},
        "orientation": {"enum": ["upright", "reversed"]},
        "card_role_in_question": {"type": "string", "minLength": 1},
        "practical_tension": {"type": "string", "minLength": 1},
        "bounded_direction": {"type": "string", "minLength": 1},
        "reflection_point": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
