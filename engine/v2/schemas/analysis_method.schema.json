{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liminal.local/schemas/analysis_method.schema.json",
  "title": "Liminal Analysis Method",
  "type": "object",
  "required": [
    "method_version",
    "integration_status",
    "purpose",
    "separation_rules",
    "epistemic_ladder",
    "transformation_taxonomy",
    "session_pattern_gate",
    "pass2_integration_gate",
    "change_control"
  ],
  "properties": {
    "method_version": {"const": "0.1.0"},
    "integration_status": {"const": "shadow_only_not_prompt_input"},
    "purpose": {"type": "string", "minLength": 1},
    "separation_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "epistemic_ladder": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "transformation_taxonomy": {
      "type": "object",
      "required": [
        "convergence", "omission", "inversion", "addition",
        "emotional_recoding", "agency_shift", "identification_shift", "temporal_shift"
      ],
      "additionalProperties": false
    },
    "session_pattern_gate": {"type": "object"},
    "pass2_integration_gate": {"type": "object"},
    "change_control": {"type": "object"}
  },
  "additionalProperties": false
}
